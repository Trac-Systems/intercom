{
  "name": "contract-test-latest",
  "version": "0.0.9",
  "type": "module",
  "main": "index.js",
  "pear": {
    "name": "contract-test-latest",
    "type": "terminal"
  },
  "dependencies": {
    "b4a": "^1.6.7",
    "bare-ws": "2.0.3",
    "compact-encoding": "^2.18.0",
    "crypto": "npm:bare-node-crypto",
    "fs": "npm:bare-node-fs",
    "path": "npm:bare-node-path",
    "pear-runtime": "1.3.1",
    "protomux": "^3.10.1",
    "hyperschema": "1.17.1",
    "trac-msb": "github:Trac-Systems/main_settlement_bus#7f98f44619e026571ea9dd7f69d1962abff78161",
    "trac-peer": "github:Trac-Systems/trac-peer#b2a4b86dae8b998561472b2c23fe8584058200c8",
    "trac-wallet": "1.0.1",
    "util": "npm:bare-node-util",
    "blind-relay": "1.6.1",
    "hyperdht": "6.29.6"
  },
  "scripts": {
    "postinstall": "node node_modules/trac-msb/scripts/hypercore-stallfix/apply.mjs && node node_modules/trac-peer/scripts/hypercore-stallfix/apply.mjs",
    "start": "node scripts/pear-runner.mjs",
    "peer": "node scripts/pear-runner.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:pear-runner": "node --test tests/pear-runner.test.mjs"
  },
  "overrides": {
    "blind-relay": "$blind-relay",
    "hyperdht": "$hyperdht",
    "trac-msb": "$trac-msb"
  }
}
