{
  "name": "contract-test-latest",
  "version": "0.0.12",
  "type": "module",
  "main": "index.js",
  "pear": {
    "name": "contract-test-latest",
    "type": "terminal"
  },
  "dependencies": {
    "b4a": "^1.6.7",
    "bare-ws": "2.0.3",
    "compact-encoding": "^2.18.0",
    "crypto": "npm:bare-node-crypto",
    "fs": "npm:bare-node-fs",
    "path": "npm:bare-node-path",
    "pear-runtime": "1.3.1",
    "protomux": "^3.10.1",
    "hyperschema": "1.17.1",
    "trac-msb": "github:Trac-Systems/main_settlement_bus#a8fdbc9b3c55a9d33a1b7c6e8c300cfbd42bd7f6",
    "trac-peer": "github:Trac-Systems/trac-peer#601de30344d9d06a4e099b770862254b91fb9b15",
    "trac-wallet": "1.0.1",
    "util": "npm:bare-node-util",
    "blind-relay": "1.6.1",
    "hyperdht": "6.29.6",
    "bogon": "^1.2.0"
  },
  "scripts": {
    "postinstall": "node node_modules/trac-msb/scripts/check-hyperdht-bogon.cjs && node node_modules/trac-peer/scripts/check-hyperdht-bogon.cjs && node node_modules/trac-msb/scripts/hypercore-stallfix/apply.mjs && node node_modules/trac-peer/scripts/hypercore-stallfix/apply.mjs",
    "start": "node scripts/pear-runner.mjs",
    "peer": "node scripts/pear-runner.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:review": "node --test tests/review/*.test.mjs",
    "test:pear-runner": "node --test tests/pear-runner.test.mjs"
  },
  "overrides": {
    "blind-relay": "$blind-relay",
    "hyperdht": "$hyperdht",
    "trac-msb": "$trac-msb"
  }
}
